APP_NAME=DanovaDigital
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<YOUR_VERCEL_DOMAIN>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DATABASE_URL=
# Neon endpoint hint (required on some clients / environments)
PGOPTIONS=endpoint=<YOUR_NEON_ENDPOINT_ID>

# Serverless-friendly defaults
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
